import ZRootPVR
open ZNumBin ZPoly ZIv ZRoot ZRootP ZRootPVR
set_option maxRecDepth 100000

/-!
# ZImplicitFan — the fan's operating point (blind test b02) as a theorem on VR's continuum. Zero axioms.

Generated by `tools/zimplicit2lean.py` from the law of `test_implicit.py`, `pmax·(1 − Q/Qmax) − K·Q² = 0` with
`pmax ∈ [44.16, 51.84]`, `Qmax ∈ [0.038, 0.042]`, `K ∈ [27200, 36800]`: the law times the positive `Qmax` (and its
sign flipped, so that it increases in `Q`) is the integer polynomial `f` below. For EVERY VR point of the
parameters strictly inside the dyadic box `ps` (the margin `2⁻¹⁸` keeps the user's box inside), `f` has a root
`Q` in the bracket, and only one there (`law_root`) — the existence premise of `ZImplicit`, here a theorem.
Not proved in Lean: that `f = −Qmax · g` (sympy's algebra in the bridge) and that the user's box lies inside the
inner region (Python's exact fractions there).
-/

namespace ZImplicitFan

def f : PE := (.add (.add (.mul (.mul (.mul (.cst ⟨⟨1, 0⟩, 0⟩) (.pow (.var 0) 2)) (.pow (.var 1) 1)) (.pow (.var 2) 1)) (.mul (.mul (.cst ⟨⟨1, 0⟩, 0⟩) (.pow (.var 0) 1)) (.pow (.var 3) 1))) (.mul (.mul (.cst ⟨⟨0, 1⟩, 0⟩) (.pow (.var 2) 1)) (.pow (.var 3) 1)))
def ps : PS := [(1, (⟨⟨26600, 0⟩, 0⟩, ⟨⟨37400, 0⟩, 0⟩), ⟨⟨1, 0⟩, 4⟩), (2, (⟨⟨2473, 0⟩, 16⟩, ⟨⟨2769, 0⟩, 16⟩), ⟨⟨699, 0⟩, 4⟩), (3, (⟨⟨2795, 0⟩, 6⟩, ⟨⟨3349, 0⟩, 6⟩), ⟨⟨1, 0⟩, 4⟩)]

theorem cert : RC f ⟨⟨9463, 0⟩, 19⟩ ⟨⟨515771, 0⟩, 24⟩ ps 4 0 8 0 ⟨⟨299, 0⟩, 1⟩ where
  hab := by decide +kernel
  h0 := rfl
  hY0 := rfl
  hY := by decide +kernel
  ends_a := by
    obtain ⟨K, hK⟩ : ∃ K, ivE (BoxOf ⟨⟨9463, 0⟩, 19⟩ ⟨⟨9463, 0⟩, 19⟩ ps) f = some K := ⟨_, rfl⟩
    exact ⟨K, hK, by rw [show K = _ from (Option.some.inj hK).symm]; decide +kernel⟩
  ends_b := by
    obtain ⟨K, hK⟩ : ∃ K, ivE (BoxOf ⟨⟨515771, 0⟩, 24⟩ ⟨⟨515771, 0⟩, 24⟩ ps) f = some K := ⟨_, rfl⟩
    exact ⟨K, hK, by rw [show K = _ from (Option.some.inj hK).symm]; decide +kernel⟩
  slope := by
    obtain ⟨K, hK⟩ : ∃ K, ivE (ZRootP.BY (BoxOf ⟨⟨9463, 0⟩, 19⟩ ⟨⟨515771, 0⟩, 24⟩ ps) 0 4) (ZRootP.ddv 0 4 f) = some K := ⟨_, rfl⟩
    exact ⟨K, hK, by rw [show K = _ from (Option.some.inj hK).symm]; decide +kernel,
      by rw [show K = _ from (Option.some.inj hK).symm]; decide +kernel⟩
  lip := by decide +kernel
  lsum := by decide +kernel
  lx := by decide +kernel
  wid := by decide +kernel

/-- **The fan's operating point**: for every VR parameter point strictly inside the box (margin 2^-18), the law has a root in
`[0.0180492, 0.0307423]`, and it is the only one there. (f = M·L·g, M, L > 0: Python's algebra.) -/
theorem law_root (p : Nat → VR.Numbers.RExpr) (hin : InnerIn 18 p ps) :
    ∃ x, (VR.Numbers.rle (dv ZRealCF.rOH ⟨⟨9463, 0⟩, 19⟩) x ∧ VR.Numbers.rle x (dv ZRealCF.rOH ⟨⟨515771, 0⟩, 24⟩)) ∧
      VR.Numbers.rEq (G f ⟨⟨9463, 0⟩, 19⟩ ps p x) VR.Numbers.rzero ∧
      ∀ y, (VR.Numbers.rle (dv ZRealCF.rOH ⟨⟨9463, 0⟩, 19⟩) y ∧ VR.Numbers.rle y (dv ZRealCF.rOH ⟨⟨515771, 0⟩, 24⟩)) →
        VR.Numbers.rEq (G f ⟨⟨9463, 0⟩, 19⟩ ps p y) VR.Numbers.rzero → VR.Numbers.rEq x y :=
  ⟨root f _ _ ps p cert hin, root_in f _ _ ps p cert hin, root_is_root f _ _ ps p cert hin,
    fun y hy ry => root_unique f _ _ ps cert (parIn_inner p hin) (root_in f _ _ ps p cert hin) hy
      (root_is_root f _ _ ps p cert hin) ry⟩

end ZImplicitFan

#print axioms ZImplicitFan.law_root
